{
  "name": "bezent-windsurf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix client",
    "start": "node server/index.js",
    "dev": "npm run dev --prefix client",
    "dev:mobile": "npm run dev:mobile --prefix client",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.3.0",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
